GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret" # 秘密キーなので漏洩に注意

# WebSocketサーバーのポート (例: 8080)
PORT=8080

# バックエンド JWTトークン署名用秘密鍵（本番環境では強力な秘密鍵を使用してください）
JWT_SECRET="jwt-secret-key"

# 追加で許可するCORSオリジン（カンマ区切り、省略可）
CORS_ALLOWED_ORIGINS="https://your-elb-url.elb.amazonaws.com,https://your-custom-domain.com"

